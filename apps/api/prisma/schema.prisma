generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceStatus {
  INACTIVE
  ACTIVE
  BLOCKED
  TRIAL
  OVERDUE
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT
  ADMIN
  CASHIER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

model Workspace {
  id        String          @id @default(cuid())
  name      String
  document  String?
  phone     String?
  logoUrl   String?
  status    WorkspaceStatus @default(INACTIVE)
  trialUntil DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  users             User[]
  products          Product[]
  sales             Sale[]
  subscriptions     Subscription[]
  mercadoPagoConfig MercadoPagoConfig?
  whatsappAgents    WhatsappAgent[]
  modulePermission  ModulePermission?

  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  isActive     Boolean    @default(true)
  refreshHash  String?
  permissions  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sales         Sale[]
  auditLogs     AuditLog[]

  @@index([workspaceId])
  @@index([role])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  visible     Boolean  @default(true)
  active      Boolean  @default(true)
  maxProducts Int?
  maxCashiers Int?
  maxAgents   Int?
  features    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime?
  graceUntil     DateTime?
  mercadoPagoPreapprovalId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  payments Payment[]

  @@index([workspaceId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  workspaceId    String?
  amountCents    Int
  method         PaymentMethod?
  status         PaymentStatus @default(PENDING)
  mercadoPagoId  String?
  description    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model MercadoPagoConfig {
  id          String    @id @default(cuid())
  workspaceId String   @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publicKey   String?
  accessToken String?
  pixEnabled  Boolean  @default(true)
  boletoEnabled Boolean @default(false)
  creditEnabled Boolean @default(true)
  debitEnabled Boolean  @default(true)
  cashEnabled Boolean   @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ModulePermission {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pix          Boolean   @default(true)
  boleto       Boolean   @default(false)
  creditCard   Boolean   @default(true)
  debitCard    Boolean   @default(true)
  cash         Boolean   @default(true)
  whatsappAgent Boolean  @default(false)
  nfce         Boolean   @default(false)
  reports      Boolean  @default(true)
  dashboard    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  barcode     String?
  description String?
  priceCents  Int
  stock       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items SaleItem[]
  @@index([workspaceId])
  @@index([barcode])
}

model Sale {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashierId   String?
  cashier     User?         @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  totalCents  Int
  method      PaymentMethod
  status      PaymentStatus @default(APPROVED)
  receiptCode String        @unique
  createdAt   DateTime      @default(now())

  items SaleItem[]
  @@index([workspaceId])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  quantity   Int
  unitCents  Int
  totalCents Int
}

model WhatsappAgent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean   @default(false)
  sessionId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
}
